# Backend Environment Variables (Configured on Render)

# Google Gemini API Key
chat_api=your_google_gemini_api_key

# Azure Speech Service Credentials
azure_speech_key=your_azure_speech_key
azure_speech_region=centralindia

# Azure Cosmos DB Credentials
azure_cosmos_uri=https://your-cosmos-account.documents.azure.com:443/
azure_cosmos_key=your_azure_cosmos_primary_key

# Security: JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated, optional)
# Render backend automatically allows any *.vercel.app domain via regex.
# Add your custom domains or local development URLs below:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
